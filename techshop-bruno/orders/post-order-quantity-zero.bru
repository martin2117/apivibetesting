      "lastName": "Doe",
      "email": "jane@example.com",
      "phone": "0412345678"
    },
    "payment": {
      "cardNumber": "4111111111111111",
      "expiryDate": "12/28",
      "cvv": "123"
    }
  }
}

tests {
