meta {
  name: Post Order Quantity Zero
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{authToken}}
}

body:json {
  {
    "items": [
