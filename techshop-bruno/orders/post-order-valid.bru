meta {
  name: Post Order Valid
  type: http
  seq: 15
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{authToken}}
}

body:json {
  {
    "items": [
      {
        "productId": 1,
        "quantity": 1
      }
    ],
    "shipping": {
      "firstName": "Jane",
      "lastName": "Doe",
      "email": "jane@example.com",
      "phone": "0412345678"
    },
    "payment": {
      "cardNumber": "4111111111111111",
      "expiryDate": "12/28",
      "cvv": "123"
    }
  }
}

tests {
  test("Status code is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("Order has id starting with ORD-", function () {
    const order = res.getBody();
    expect(order.id).to.be.a("string");
    expect(order.id).to.match(/^ORD-/);
  });
  test("Order has status and total", function () {
    const order = res.getBody();
    expect(order).to.have.property("status");
    expect(order).to.have.property("total");
  });
  test("Payment response has last4", function () {
    expect(res.getBody().payment).to.have.property("last4");
  });
}
