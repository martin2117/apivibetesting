meta {
  name: Post Order Past Expiry
  type: http
  seq: 13
}

post {
  url: {{baseUrl}}/orders
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{authToken}}
}

body:json {
  {
    "items": [
      {
        "productId": 1,
        "quantity": 1
      }
    ],
    "shipping": {
      "firstName": "Jane",
      "lastName": "Doe",
      "email": "jane@example.com",
      "phone": "0412345678"
    },
    "payment": {
      "cardNumber": "4111111111111111",
      "expiryDate": "01/20",
      "cvv": "123"
    }
  }
}

tests {
  test("Status code is 400", function () {
    expect(res.getStatus()).to.equal(400);
  });

  test("Response has error message", function () {
    const body = res.getBody();
    expect(body.error || body.message).to.be.a("string");
  });
}