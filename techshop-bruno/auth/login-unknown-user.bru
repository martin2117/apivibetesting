meta {
  name: Login Unknown User
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/auth/login
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "email": "nobody@unknown-domain-xyz.com",
    "password": "irrelevant"
  }
}

tests {
  test("Status code is 401", function () {
    expect(res.getStatus()).to.equal(401);
  });
  test("Response has error message", function () {
    const body = res.getBody();
    expect(body.error || body.message).to.be.a("string");
  });
}
