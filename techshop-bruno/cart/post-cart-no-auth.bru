meta {
  name: Post Cart No Auth
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/cart
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "productId": 1,
    "quantity": 2
  }
}

tests {
  test("Status code is 401", function () {
    expect(res.getStatus()).to.equal(401);
  });

  test("Response has error message", function () {
    const body = res.getBody();
    expect(body.error || body.message).to.be.a("string");
  });
}