meta {
  name: Post Cart Valid
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/cart
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{authToken}}
}

body:json {
  {
    "productId": 1,
    "quantity": 2
  }
}

tests {
  test("Status code is 201", function () {
    expect(res.getStatus()).to.equal(201);
  });
  test("Response body is not null", function () {
    expect(res.getBody()).to.not.be.null;
  });
}

script:post-response {
  const data = res.getBody();
  if (res.getStatus() === 201 && data) {
    // API returns the full cart: { id, items: [{ id, productId, ... }], total }
    const itemId = data.id || (data.items && data.items[0] && data.items[0].id);
    if (itemId) {
      bru.setVar("cartItemId", String(itemId));
      bru.setEnvVar("cartItemId", String(itemId));
    }
  }
}
