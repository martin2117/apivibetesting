meta {
  name: Put Cart Item Not Found
  type: http
  seq: 18
}

put {
  url: {{baseUrl}}/cart/99999
  body: json
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{authToken}}
}

body:json {
  {
    "quantity": 3
  }
}

tests {
  test("Status code is 404", function () {
    expect(res.getStatus()).to.equal(404);
  });
}
