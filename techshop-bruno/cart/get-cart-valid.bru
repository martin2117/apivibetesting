meta {
  name: Get Cart Valid
  type: http
  seq: 12
}

get {
  url: {{baseUrl}}/cart
  body: none
  auth: none
}

headers {
  content-type: application/json
  authorization: Bearer {{authToken}}
}

tests {
  test("Status code is 200", function () {
    expect(res.getStatus()).to.equal(200);
  });
  test("Cart has items array", function () {
    expect(res.getBody()).to.have.property("items");
    expect(res.getBody().items).to.be.an("array");
  });
  test("Cart has numeric total", function () {
    expect(res.getBody()).to.have.property("total");
    expect(res.getBody().total).to.be.a("number");
  });
}
