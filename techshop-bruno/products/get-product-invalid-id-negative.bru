meta {
  name: Get Product Invalid Id Negative
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/products/-1
  body: none
  auth: none
}

headers {
  content-type: application/json
}

tests {
  test("Status code is 400 or 404", function () {
    expect(res.getStatus()).to.be.oneOf([400, 404]);
  });
  test("Response has error message", function () {
    const body = res.getBody();
    expect(body.error || body.message).to.be.a("string");
  });
}
