meta {
  name: Get Products Invalid Category
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/products?category=invalid-category
  body: none
  auth: none
}

headers {
  content-type: application/json
}

tests {
  test("Status code is 200 or 400", function () {
    expect(res.getStatus()).to.be.oneOf([200, 400]);
  });
  test("When 200, response is an array", function () {
    if (res.getStatus() === 200) {
      expect(res.getBody()).to.be.an("array");
    }
  });
}
